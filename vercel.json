{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "build": {
    "env": {
      "PUPPETEER_SKIP_DOWNLOAD": "true"
    }
  },
  "redirects": [
    {
      "source": "/previews/:name.wav",
      "destination": "/previews/:name.mp3",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "www.djdxmusic.com"
        }
      ],
      "destination": "https://djdxmusic.com/:path*",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/pricing.md",
      "destination": "/pricing.txt"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/poll/(.*)",
      "destination": "/poll-shell.html"
    },
    {
      "source": "/admin",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains; preload"
        }
      ]
    },
    {
      "source": "/poll/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/plan",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/pricing.md",
      "headers": [
        {
          "key": "Link",
          "value": "<https://djdxmusic.com/pricing.txt>; rel=\"canonical\""
        }
      ]
    },
    {
      "source": "/pricing.txt",
      "headers": [
        {
          "key": "Link",
          "value": "<https://djdxmusic.com/pricing.txt>; rel=\"canonical\""
        }
      ]
    },
    {
      "source": "/llms.txt",
      "headers": [
        {
          "key": "Link",
          "value": "<https://djdxmusic.com/llms.txt>; rel=\"canonical\""
        }
      ]
    },
    {
      "source": "/.well-known/(.*)",
      "headers": [
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=300, s-maxage=300"
        }
      ]
    },
    {
      "source": "/.well-known/business.jws",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/jose; charset=utf-8"
        }
      ]
    },
    {
      "source": "/.well-known/did.json",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/did+json; charset=utf-8"
        }
      ]
    },
    {
      "source": "/confirm",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    }
  ],
  "crons": [
    {
      "path": "/api/ai-visibility",
      "schedule": "0 14 1 * *"
    }
  ],
  "functions": {
    "api/ai-visibility.ts": {
      "maxDuration": 300
    }
  }
}
